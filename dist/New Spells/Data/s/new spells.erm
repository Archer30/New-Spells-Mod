ZVSE2
; Author:   Archer30
; Engine:   ERM 2.0+
; Requires: ERA 3.9+

; Public runtime range helper for New Spells. Spell metadata, hero spell access
; and text are handled natively by SS, HE:M and SN:H.

; Return the highest defined hero-spell ID. New Spells publishes the physical
; spell-table size in i^NewSpells.SpellCount^, which can include reserved or
; creature-only records. Legacy IDs retain their normal WoG behaviour; extended
; IDs must be a level 1..5 spell without the native creature-spell flag (bit 0x8).
!?FU(GetMaxSpellId);
!#VA(result:x);

!!VR(result):S(SPELL_LAST_WOG);
!!VR(numSpells:y):Si^NewSpells.SpellCount^;
!!VR(lastPhysicalSpellId:y):S(numSpells) -1;
!!VR(firstExtendedSpellId:y):S(SPELL_LAST_WOG) +1;

!!if&(lastPhysicalSpellId)>=(firstExtendedSpellId);
  !!re (spell:y)/(lastPhysicalSpellId)/(firstExtendedSpellId)/-1;
    !!SS(spell):L?(level:y) F?(flags:y);
    !!VR(creatureFlag:y):S(flags) &8;

    !!if&(level)>=1/(level)<=5/(creatureFlag)=0;
      !!VR(result):S(spell);
      !!br;
    !!en;
  !!en;
!!en;

; Events of spell ids 70 and up. A pack adds its own triggers with the same names.
; x1 spell, x2 side, x3 target hex, x4 mastery, x5 power, x6 creature cast flag
!?FU(NewSpells_OnBattleCast);
!#VA(spell:x) (side:x) (hex:x) (mastery:x) (power:x) (creature:x);

; x1 spell, x2 side, x3 stack index, x4 mastery, x5 applied flag, x6 hero id
!?FU(NewSpells_OnStackSpell);
!#VA(spell:x) (side:x) (stack:x) (mastery:x) (applied:x) (hero:x);

; x1 spell, x2 hero id, x3 mastery
!?FU(NewSpells_OnAdventureCast);
!#VA(spell:x) (hero:x) (mastery:x);
